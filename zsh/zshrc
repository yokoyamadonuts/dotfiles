# ============================================================
# Git Worktree Management for Parallel Claude Code Workflows
# ============================================================
# Usage:
#   wt        - List all worktrees with fzf selection
#   wt a      - Switch to worktree 'a'
#   wt-add a  - Create new worktree 'a' from current branch
#   wt-rm a   - Remove worktree 'a'
#   za/zb/zc  - Quick switch to worktree a/b/c
# ============================================================

export WORKTREE_BASE="${WORKTREE_BASE:-$HOME/.worktrees}"

# List and switch worktrees with fzf
wt() {
  if [[ -z "$1" ]]; then
    # fzf selection mode
    local selected=$(git worktree list | fzf --height=40% --reverse \
      --preview='cd {1} && git log --oneline -10' \
      --preview-window=down:40% | awk '{print $1}')
    [[ -n "$selected" ]] && cd "$selected"
  else
    # Direct switch mode
    local repo_name=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")
    local target="$WORKTREE_BASE/$repo_name-$1"
    if [[ -d "$target" ]]; then
      cd "$target"
    else
      echo "Worktree '$1' not found. Create with: wt-add $1"
    fi
  fi
}

# Create new worktree
wt-add() {
  [[ -z "$1" ]] && { echo "Usage: wt-add <name> [branch]"; return 1; }
  local repo_name=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")
  local target="$WORKTREE_BASE/$repo_name-$1"
  local branch="${2:-$(git branch --show-current)}"
  mkdir -p "$WORKTREE_BASE"
  git worktree add "$target" -b "worktree-$1" "$branch" 2>/dev/null || \
    git worktree add "$target" "$branch"
  echo "Created worktree: $target"
  cd "$target"
}

# Ask, then `docker compose down` the given projects (callers list them first).
# Shared by wt-rm and compose-gc. Returns 1 when the user declines.
_compose_down_confirm() {
  (( $# )) || return 0
  local -a down_args=(--remove-orphans)
  local answer
  read -r "answer?Stop them? [y/N] "
  [[ "$answer" == [yY]* ]] || return 1

  read -r "answer?Also delete their volumes (DB data is lost)? [y/N] "
  [[ "$answer" == [yY]* ]] && down_args+=(--volumes)

  local p
  for p in "$@"; do
    docker compose -p "$p" down $down_args
  done
}

# Stop docker compose projects whose compose files live under <dir>.
# Declining keeps the worktree, so the stacks are not left orphaned.
_wt_compose_down() {
  (( $+commands[docker] && $+commands[jq] )) || return 0
  # compose records absolute, symlink-resolved paths
  local real="${1:A}"
  # Empty when Docker is not running, so wt-rm still works offline.
  local -a projects=("${(@f)$(docker compose ls --all --format json 2>/dev/null \
    | jq -r --arg d "$real/" \
        '.[] | select(.ConfigFiles | split(",") | any(startswith($d))) | .Name')}")
  projects=(${projects:#})
  (( ${#projects} )) || return 0

  echo "Docker compose stacks under $real:"
  printf '  %s\n' $projects
  _compose_down_confirm $projects
}

# Stop docker compose stacks whose compose files no longer exist
# (e.g. started from a worktree that Claude Code or `git worktree remove` deleted).
compose-gc() {
  (( $+commands[docker] && $+commands[jq] )) || { echo "compose-gc needs docker and jq"; return 1; }
  local listing
  listing=$(docker compose ls --all --format json 2>/dev/null) || { echo "Docker is not running"; return 1; }

  local -a orphans lines files
  local name cfg f alive
  while IFS=$'\t' read -r name cfg; do
    [[ -n "$name" ]] || continue
    files=(${(s:,:)cfg})
    # Orphaned only when every compose file is gone
    alive=0
    for f in $files; do [[ -e "$f" ]] && alive=1; done
    if (( ! alive )); then
      orphans+=("$name")
      lines+=("$(printf '  %-40s %s' "$name" "${files[1]:h}")")
    fi
  done < <(print -r -- "$listing" | jq -r '.[] | [.Name, .ConfigFiles] | @tsv')

  if (( ! ${#orphans} )); then
    echo "No orphaned compose stacks."
    return 0
  fi

  echo "Orphaned compose stacks (their compose files are gone):"
  printf '%s\n' $lines
  _compose_down_confirm $orphans
}

# Remove worktree (and the docker compose stacks started from it)
wt-rm() {
  [[ -z "$1" ]] && { echo "Usage: wt-rm <name>"; return 1; }
  local repo_name=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)")
  local target="$WORKTREE_BASE/$repo_name-$1"
  _wt_compose_down "$target" || { echo "Aborted, worktree kept: $target"; return 1; }
  git worktree remove "$target" --force 2>/dev/null && \
    echo "Removed worktree: $target" || \
    echo "Failed to remove worktree: $target"
}

