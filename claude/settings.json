{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-1[1m]",
  "effortLevel": "xhigh",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__pencil"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env --allow-run --allow-read --allow-write \"$HOME/.claude/hooks/format.ts\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env --allow-read \"$HOME/.claude/hooks/skill-memory.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env --allow-run --allow-read \"$HOME/.claude/hooks/notify.ts\" --type stop",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env --allow-run --allow-read \"$HOME/.claude/hooks/notify.ts\" --type failure",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "deno run --allow-env --allow-run --allow-read \"$HOME/.claude/hooks/notify.ts\" --type notify",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-opus-4-5-migration@claude-code-plugins": false,
    "code-review@claude-code-plugins": true,
    "commit-commands@claude-code-plugins": true,
    "document-skills@anthropic-agent-skills": true,
    "explanatory-output-style@claude-code-plugins": false,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "hookify@claude-code-plugins": true,
    "learning-output-style@claude-code-plugins": true,
    "natural-japanese@natural-japanese": true,
    "php-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-code-plugins": true,
    "ralph-wiggum@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-code-plugins": true,
    "superpowers@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "vcsdd-claude-code": {
      "source": {
        "source": "github",
        "repo": "sc30gsw/vcsdd-claude-code"
      }
    },
    "natural-japanese": {
      "source": {
        "source": "github",
        "repo": "coji/natural-japanese"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "spinnerTipsEnabled": false
}
